# anthropic | bedrock | mock
PROVIDER=anthropic

# --- Anthropic API (default). Max/Team plan API credits apply here, not on Bedrock. ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Amazon Bedrock (if PROVIDER=bedrock) ---
AWS_REGION=us-west-2
# Option A: a Bedrock API key (bearer token)
AWS_BEARER_TOKEN_BEDROCK=
# Option B: AWS access keys (leave blank to use ~/.aws/credentials or an instance role)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# Sonnet 4.5 needs an inference profile prefix (global. / us. / eu.)
BEDROCK_MODEL=global.anthropic.claude-sonnet-4-5-20250929-v1:0

# --- Optional: real SMS. Leave blank to use the browser simulator only. ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
